{
  "name": "trail-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "lightningcss --bundle --minify --targets \">= 0.25%\" src/css/main.css -o dist/styles.css && vite build",
    "watch": "chokidar \"css/**/*.css\" -c \"npm run build\" --debounce 600",
    "preview": "vite preview",
    "lint": "eslint src/js",
    "lint-fix": "eslint src/js --fix"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "lightningcss-cli": "^1.33.0",
    "vite": "^8.1.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.2.3"
  }
}
